{
  "name": "ruizhibo-care-center",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @ruizhibo/api dev",
    "dev:admin": "pnpm --filter @ruizhibo/admin-web dev",
    "dev:parent": "pnpm --filter @ruizhibo/parent-miniapp dev:weapp",
    "dev:teacher": "pnpm --filter @ruizhibo/teacher-miniapp dev:weapp",
    "dev:teacher:h5": "pnpm --filter @ruizhibo/teacher-miniapp dev:h5",
    "build:teacher:h5": "pnpm --filter @ruizhibo/teacher-miniapp build:h5",
    "verify:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-test-deployment.ps1",
    "verify:dev-acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-dev-acceptance.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-test-deployment.ps1 -ProductionGate",
    "verify:production-config": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-production-config.ps1",
    "backup:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/backup-test-deployment.ps1",
    "restore:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/restore-test-deployment.ps1",
    "test:training": "pnpm --filter @ruizhibo/api test:training",
    "verify:training-api": "pnpm --filter @ruizhibo/api verify:training-api",
    "verify:training-media": "pnpm --filter @ruizhibo/api verify:training-media",
    "verify:training-isolation": "pnpm --filter @ruizhibo/api verify:training-isolation",
    "verify:training-feature-flag": "pnpm --filter @ruizhibo/api verify:training-feature-flag",
    "verify:training-load": "pnpm --filter @ruizhibo/api verify:training-load",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
