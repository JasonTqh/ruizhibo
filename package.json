{
  "name": "ruizhibo-care-center",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @ruizhibo/api dev",
    "dev:admin": "pnpm --filter @ruizhibo/admin-web dev",
    "dev:parent": "pnpm --filter @ruizhibo/parent-miniapp dev:weapp",
    "dev:teacher": "pnpm --filter @ruizhibo/teacher-miniapp dev:weapp",
    "verify:deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-test-deployment.ps1",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
