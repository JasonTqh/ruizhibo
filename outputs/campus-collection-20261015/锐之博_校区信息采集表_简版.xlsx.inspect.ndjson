{"kind":"table","sheet":"校区信息","address":"A1:B23","rows":23,"cols":2,"values":[[null,null],["锐之博校区信息采集表（简版）",null],["每个校区填写一份；浅黄色填写，带 * 必填，其余可留空。",null],[null,null],["填写项目","填写内容"],["校区名称 *",null],["主管姓名 *",null],["主管手机号 *",null],["填表日期 *",null],["校区地址",null],["数据用途 *",null],["补充说明",null],[null,null],[null,null],["只需填写下面两张名单",null],["① 教师与主管：填写姓名、手机号、岗位及负责班级。",null],["② 学生与家长：每个学生一行，填写班级、学生和一至两位家长的信息。",null],["班级名称保持一致；同班同名学生请在姓名后加不同标记，并在备注说明。",null],["一位教师负责多个班时，用顿号隔开班名；每班明确一位负责教师。",null],["每位学生至少填一位家长；第二位家长可不填，填写时姓名、关系、手机号须齐全。",null],["暂未确定家长时，在备注写“待补家长”；更多家长或接送安排也写在备注中。",null],["手机号填写实际登录使用的号码；不填写密码、验证码。权限由管理员另行确认。",null],["填完请主管核对，文件改名为“校区名称_信息采集_日期.xlsx”后交回。",null]]}
