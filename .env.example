NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruizhibo
JWT_SECRET=change-me-in-production
TRAINING_MEDIA_SIGNING_SECRET=change-me-separately-in-production
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
WECHAT_TEACHER_APP_ID=
WECHAT_TEACHER_APP_SECRET=
WECHAT_PARENT_APP_ID=
WECHAT_PARENT_APP_SECRET=
# 单小程序兼容配置；角色专用配置优先。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FILE_STORAGE_DRIVER=local
TRAINING_MEDIA_URL_SECONDS=900
TRAINING_IMAGE_MAX_MB=10
TRAINING_VIDEO_MAX_MB=500
TRAINING_IDLE_SECONDS=300
TRAINING_JOB_INTERVAL_MS=900000
BACKUP_RETENTION_DAYS=30
LOCAL_UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Frontend defaults; copy the matching app-level .env.example to .env.local.
VITE_API_BASE_URL=http://localhost:3000/api
TARO_APP_API_BASE_URL=http://localhost:3000/api
