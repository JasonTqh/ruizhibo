{
  "name": "@ruizhibo/teacher-miniapp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type weapp --env production",
    "build:h5": "taro build --type h5 --env production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"teacher miniapp lint pending\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\""
  },
  "dependencies": {
    "@ruizhibo/shared": "workspace:*",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-h5": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "0.5.15",
    "@tarojs/cli": "4.2.0",
    "@tarojs/webpack5-runner": "4.2.0",
    "@types/react": "^18.3.16",
    "babel-preset-taro": "4.2.0",
    "react-refresh": "0.14.0",
    "typescript": "^5.7.2"
  }
}
