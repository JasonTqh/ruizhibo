NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ruizhibo?schema=public
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173

# 本地联调可开启；生产环境必须为 false 或不设置。
ENABLE_DEV_LOGIN=true

# 教师端与家长端应分别配置各自小程序的 AppID / AppSecret。
WECHAT_TEACHER_APP_ID=
WECHAT_TEACHER_APP_SECRET=
WECHAT_PARENT_APP_ID=
WECHAT_PARENT_APP_SECRET=

# 仅用于单小程序兼容配置；存在角色专用配置时优先使用角色专用配置。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
