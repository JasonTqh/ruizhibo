generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  teacher
  parent
}

enum UserStatus {
  active
  disabled
}

enum StudentStatus {
  active
  inactive
  graduated
}

enum AttendanceType {
  arrive
  leave
  late
  absence
}

enum HomeworkStatus {
  pending
  submitted
  reviewed
  overdue
}

enum GrowthRecordType {
  attendance
  homework
  workflow
  teacher_feedback
  notice
}

enum MessageKind {
  text
  image
  file
  system
}

enum NoticeKind {
  notice
  task
}

model User {
  id           String     @id @default(cuid())
  role         UserRole
  name         String
  phone        String?    @unique
  wechatOpenid String?    @unique
  avatarUrl    String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teachingClasses  Class[]              @relation("ClassTeacher")
  guardianships    StudentGuardian[]
  attendanceLogs   AttendanceEvent[]    @relation("AttendanceTeacher")
  workflowSessions WorkflowSession[]
  workflowChecks   WorkflowStep[]       @relation("WorkflowStepTeacher")
  homeworkAssigned HomeworkAssignment[]
  teachingRecords  TeachingRecord[]
  growthRecords    GrowthRecord[]
  sentMessages     Message[]
  publishedNotices Notice[]             @relation("NoticeTeacher")
  noticeReceipts   NoticeReceipt[]      @relation("NoticeReceiptParent")
  auditLogs        AuditLog[]
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model Class {
  id        String   @id @default(cuid())
  campusId  String
  name      String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus              Campus               @relation(fields: [campusId], references: [id])
  teacher             User?                @relation("ClassTeacher", fields: [teacherId], references: [id])
  students            Student[]
  workflowSessions    WorkflowSession[]
  homeworkAssignments HomeworkAssignment[]
  teachingRecords     TeachingRecord[]
  notices             Notice[]
}

model Student {
  id        String        @id @default(cuid())
  classId   String
  name      String
  gender    String?
  birthday  DateTime?
  status    StudentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  class          Class                @relation(fields: [classId], references: [id])
  guardians      StudentGuardian[]
  attendance     AttendanceEvent[]
  submissions    HomeworkSubmission[]
  growthRecords  GrowthRecord[]
  conversations  Conversation[]
  noticeReceipts NoticeReceipt[]
}

model StudentGuardian {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  relation  String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])
  parent  User    @relation(fields: [parentId], references: [id])

  @@unique([studentId, parentId])
}

model AttendanceEvent {
  id         String         @id @default(cuid())
  studentId  String
  type       AttendanceType
  happenedAt DateTime
  teacherId  String?
  remark     String?
  createdAt  DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id])
  teacher User?   @relation("AttendanceTeacher", fields: [teacherId], references: [id])
}

model WorkflowTemplate {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps    WorkflowTemplateStep[]
  sessions WorkflowSession[]
}

model WorkflowTemplateStep {
  id           String  @id @default(cuid())
  templateId   String
  stepKey      String
  name         String
  timeRange    String
  sortOrder    Int
  requirePhoto Boolean @default(false)

  template WorkflowTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, stepKey])
}

model WorkflowSession {
  id         String   @id @default(cuid())
  classId    String
  teacherId  String
  templateId String
  date       DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  class    Class            @relation(fields: [classId], references: [id])
  teacher  User             @relation(fields: [teacherId], references: [id])
  template WorkflowTemplate @relation(fields: [templateId], references: [id])
  steps    WorkflowStep[]

  @@unique([classId, date])
}

model WorkflowStep {
  id        String    @id @default(cuid())
  sessionId String
  stepKey   String
  name      String
  timeRange String
  sortOrder Int
  checked   Boolean   @default(false)
  checkedAt DateTime?
  teacherId String?
  photoUrls String[]  @default([])

  session WorkflowSession @relation(fields: [sessionId], references: [id])
  teacher User?           @relation("WorkflowStepTeacher", fields: [teacherId], references: [id])

  @@unique([sessionId, stepKey])
}

model HomeworkAssignment {
  id        String    @id @default(cuid())
  classId   String
  teacherId String
  title     String
  subject   String
  content   String
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class       Class                @relation(fields: [classId], references: [id])
  teacher     User                 @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  status      HomeworkStatus @default(pending)
  content     String?
  fileUrls    String[]       @default([])
  submittedAt DateTime?
  reviewedAt  DateTime?
  remark      String?

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id])
  student  Student            @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
}

model TeachingRecord {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  date      DateTime
  course    String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())

  teacher User  @relation(fields: [teacherId], references: [id])
  class   Class @relation(fields: [classId], references: [id])
}

model GrowthRecord {
  id              String           @id @default(cuid())
  studentId       String
  teacherId       String?
  type            GrowthRecordType
  title           String
  content         String
  visibleToParent Boolean          @default(true)
  happenedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])
  teacher User?   @relation(fields: [teacherId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id])
  messages Message[]

  @@unique([studentId, parentId, teacherId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  kind           MessageKind @default(text)
  content        String
  fileUrls       String[]    @default([])
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model Notice {
  id                  String     @id @default(cuid())
  classId             String
  teacherId           String
  kind                NoticeKind
  title               String
  content             String
  dueAt               DateTime?
  unboundStudentCount Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  class    Class           @relation(fields: [classId], references: [id])
  teacher  User            @relation("NoticeTeacher", fields: [teacherId], references: [id])
  receipts NoticeReceipt[]

  @@index([teacherId, createdAt])
  @@index([classId, createdAt])
}

model NoticeReceipt {
  id          String    @id @default(cuid())
  noticeId    String
  studentId   String
  parentId    String
  viewedAt    DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  parent  User    @relation("NoticeReceiptParent", fields: [parentId], references: [id])

  @@unique([noticeId, studentId, parentId])
  @@index([parentId, createdAt])
  @@index([noticeId, confirmedAt])
}

model FileAsset {
  id        String   @id @default(cuid())
  url       String
  mimeType  String
  size      Int?
  ownerId   String?
  scene     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
