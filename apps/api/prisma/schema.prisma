generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  teacher
  parent
}

enum UserStatus {
  active
  disabled
}

enum StudentStatus {
  active
  inactive
  graduated
}

enum AttendanceType {
  arrive
  leave
  late
  absence
}

enum PickupRelationship {
  father
  mother
  grandfather
  grandmother
  maternal_grandfather
  maternal_grandmother
  sibling
  relative
  other
}

enum PickupEventType {
  picked_up_from_school
  arrived_at_center
  left_center
}

enum PickupArrivalMethod {
  teacher_pickup
  parent_delivered
  self_arrived
  other
}

enum PickupHandoffStatus {
  normal
  temporary_authorization
  exception
}

enum StudentWorkflowStepStatus {
  pending
  completed
  skipped
  exception
}

enum StudentCareRecordType {
  meal
  water
  rest
  mood
  exception
}

enum CareMealSlot {
  snack
  dinner
}

enum CareExceptionCategory {
  physical
  emotional
  injury
  behavior
  other
}

enum HomeworkStatus {
  pending
  submitted
  reviewed
  overdue
}

enum GrowthRecordType {
  attendance
  homework
  workflow
  teacher_feedback
  notice
}

enum MessageKind {
  text
  image
  file
  system
}

enum NoticeKind {
  notice
  task
}

enum LessonPlanStatus {
  draft
  published
  archived
}

enum ResearchActivityType {
  discussion
  observation
  training
}

enum ResearchActivityStatus {
  draft
  open
  completed
  cancelled
}

enum ResearchParticipationStatus {
  registered
  attended
  cancelled
}

model User {
  id           String     @id @default(cuid())
  role         UserRole
  name         String
  phone        String?    @unique
  passwordHash String?
  wechatOpenid String?    @unique
  avatarUrl    String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teachingClasses        Class[]                  @relation("ClassTeacher")
  guardianships          StudentGuardian[]
  attendanceLogs         AttendanceEvent[]        @relation("AttendanceTeacher")
  workflowSessions       WorkflowSession[]
  workflowChecks         WorkflowStep[]           @relation("WorkflowStepTeacher")
  studentWorkflowSteps   StudentWorkflowStep[]    @relation("StudentWorkflowStepTeacher")
  homeworkAssigned       HomeworkAssignment[]
  teachingRecords        TeachingRecord[]
  lessonPlans            LessonPlan[]
  researchActivities     ResearchActivity[]       @relation("ResearchActivityOrganizer")
  researchParticipations ResearchParticipant[]
  growthRecords          GrowthRecord[]
  sentMessages           Message[]
  publishedNotices       Notice[]                 @relation("NoticeTeacher")
  noticeReceipts         NoticeReceipt[]          @relation("NoticeReceiptParent")
  handledPickupRecords   PickupRecord[]           @relation("PickupRecordTeacher")
  createdPickupRecords   PickupRecord[]           @relation("PickupRecordCreator")
  careRecords            StudentCareRecord[]      @relation("StudentCareRecordTeacher")
  dailyReportNotes       StudentDailyReportNote[] @relation("DailyReportNoteTeacher")
  auditLogs              AuditLog[]
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes            Class[]
  researchActivities ResearchActivity[]
  pickupRecords      PickupRecord[]
}

model Class {
  id        String   @id @default(cuid())
  campusId  String
  name      String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus              Campus               @relation(fields: [campusId], references: [id])
  teacher             User?                @relation("ClassTeacher", fields: [teacherId], references: [id])
  students            Student[]
  workflowSessions    WorkflowSession[]
  homeworkAssignments HomeworkAssignment[]
  teachingRecords     TeachingRecord[]
  lessonPlans         LessonPlan[]
  notices             Notice[]
  pickupRecords       PickupRecord[]
}

model Student {
  id        String        @id @default(cuid())
  classId   String
  name      String
  gender    String?
  birthday  DateTime?
  status    StudentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  class                  Class                    @relation(fields: [classId], references: [id])
  guardians              StudentGuardian[]
  attendance             AttendanceEvent[]
  submissions            HomeworkSubmission[]
  growthRecords          GrowthRecord[]
  conversations          Conversation[]
  noticeReceipts         NoticeReceipt[]
  authorizedPickupPeople AuthorizedPickupPerson[]
  pickupRecords          PickupRecord[]
  workflowSteps          StudentWorkflowStep[]
  careRecords            StudentCareRecord[]
  dailyReportNotes       StudentDailyReportNote[]
}

model StudentGuardian {
  id                String   @id @default(cuid())
  studentId         String
  parentId          String
  relation          String
  isPrimary         Boolean  @default(false)
  canReceiveNotice  Boolean  @default(true)
  canSubmitHomework Boolean  @default(true)
  canViewGrowth     Boolean  @default(true)
  canPickup         Boolean  @default(false)
  status            String   @default("active")
  remark            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student       Student        @relation(fields: [studentId], references: [id])
  parent        User           @relation(fields: [parentId], references: [id])
  pickupRecords PickupRecord[]

  @@unique([studentId, parentId])
}

model AttendanceEvent {
  id         String         @id @default(cuid())
  studentId  String
  type       AttendanceType
  happenedAt DateTime
  teacherId  String?
  remark     String?
  createdAt  DateTime       @default(now())

  student      Student       @relation(fields: [studentId], references: [id])
  teacher      User?         @relation("AttendanceTeacher", fields: [teacherId], references: [id])
  pickupRecord PickupRecord?
}

model AuthorizedPickupPerson {
  id           String             @id @default(cuid())
  studentId    String
  name         String
  relationship PickupRelationship
  phone        String?
  isActive     Boolean            @default(true)
  remark       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  student       Student        @relation(fields: [studentId], references: [id])
  pickupRecords PickupRecord[]

  @@index([studentId, isActive])
}

model PickupRecord {
  id                       String               @id @default(cuid())
  studentId                String
  campusId                 String
  classId                  String
  serviceDate              DateTime
  type                     PickupEventType
  happenedAt               DateTime
  teacherId                String
  createdById              String
  arrivalMethod            PickupArrivalMethod?
  studentGuardianId        String?
  pickupPersonId           String?
  pickupPersonNameSnapshot String?
  relationshipSnapshot     String?
  phoneSnapshot            String?
  status                   PickupHandoffStatus  @default(normal)
  isException              Boolean              @default(false)
  exceptionReason          String?
  resolution               String?
  remark                   String?
  attendanceEventId        String?              @unique
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  student         Student                 @relation(fields: [studentId], references: [id])
  campus          Campus                  @relation(fields: [campusId], references: [id])
  class           Class                   @relation(fields: [classId], references: [id])
  teacher         User                    @relation("PickupRecordTeacher", fields: [teacherId], references: [id])
  createdBy       User                    @relation("PickupRecordCreator", fields: [createdById], references: [id])
  studentGuardian StudentGuardian?        @relation(fields: [studentGuardianId], references: [id])
  pickupPerson    AuthorizedPickupPerson? @relation(fields: [pickupPersonId], references: [id])
  attendanceEvent AttendanceEvent?        @relation(fields: [attendanceEventId], references: [id], onDelete: SetNull)

  @@unique([studentId, serviceDate, type])
  @@index([studentId, serviceDate])
  @@index([classId, serviceDate])
  @@index([teacherId, serviceDate])
  @@index([campusId, serviceDate])
  @@index([status, serviceDate])
  @@index([isException, serviceDate])
}

model WorkflowTemplate {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps    WorkflowTemplateStep[]
  sessions WorkflowSession[]
}

model WorkflowTemplateStep {
  id           String  @id @default(cuid())
  templateId   String
  stepKey      String
  name         String
  timeRange    String
  sortOrder    Int
  requirePhoto Boolean @default(false)

  template WorkflowTemplate @relation(fields: [templateId], references: [id])

  @@unique([templateId, stepKey])
}

model WorkflowSession {
  id         String   @id @default(cuid())
  classId    String
  teacherId  String
  templateId String
  date       DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  class    Class            @relation(fields: [classId], references: [id])
  teacher  User             @relation(fields: [teacherId], references: [id])
  template WorkflowTemplate @relation(fields: [templateId], references: [id])
  steps    WorkflowStep[]

  @@unique([classId, date])
}

model WorkflowStep {
  id           String    @id @default(cuid())
  sessionId    String
  stepKey      String
  name         String
  timeRange    String
  sortOrder    Int
  requirePhoto Boolean   @default(false)
  checked      Boolean   @default(false)
  checkedAt    DateTime?
  teacherId    String?
  photoUrls    String[]  @default([])

  session      WorkflowSession       @relation(fields: [sessionId], references: [id])
  teacher      User?                 @relation("WorkflowStepTeacher", fields: [teacherId], references: [id])
  studentSteps StudentWorkflowStep[]

  @@unique([sessionId, stepKey])
}

model StudentWorkflowStep {
  id             String                    @id @default(cuid())
  workflowStepId String
  studentId      String
  status         StudentWorkflowStepStatus @default(pending)
  completedAt    DateTime?
  teacherId      String?
  photoUrls      String[]                  @default([])
  remark         String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  workflowStep WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Restrict)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher      User?        @relation("StudentWorkflowStepTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([workflowStepId, studentId])
  @@index([studentId, status])
  @@index([status])
}

model StudentCareRecord {
  id                String                 @id @default(cuid())
  studentId         String
  teacherId         String?
  type              StudentCareRecordType
  mealSlot          CareMealSlot?
  value             String?
  quantity          Int?
  durationMinutes   Int?
  exceptionCategory CareExceptionCategory?
  happenedAt        DateTime
  serviceDate       DateTime
  needsAttention    Boolean                @default(false)
  remark            String?
  resolution        String?
  photoUrls         String[]               @default([])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher User?   @relation("StudentCareRecordTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId, serviceDate])
  @@index([type, serviceDate])
  @@index([teacherId, serviceDate])
  @@index([needsAttention, serviceDate])
}

model StudentDailyReportNote {
  id          String    @id @default(cuid())
  studentId   String
  serviceDate DateTime
  teacherId   String?
  comment     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher User?   @relation("DailyReportNoteTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, serviceDate])
  @@index([serviceDate])
  @@index([teacherId, serviceDate])
}

model HomeworkAssignment {
  id        String    @id @default(cuid())
  classId   String
  teacherId String
  title     String
  subject   String
  content   String
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class       Class                @relation(fields: [classId], references: [id])
  teacher     User                 @relation(fields: [teacherId], references: [id])
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String         @id @default(cuid())
  homeworkId  String
  studentId   String
  status      HomeworkStatus @default(pending)
  content     String?
  fileUrls    String[]       @default([])
  submittedAt DateTime?
  reviewedAt  DateTime?
  remark      String?

  homework HomeworkAssignment @relation(fields: [homeworkId], references: [id])
  student  Student            @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
}

model TeachingRecord {
  id        String   @id @default(cuid())
  teacherId String
  classId   String
  date      DateTime
  course    String
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())

  teacher User  @relation(fields: [teacherId], references: [id])
  class   Class @relation(fields: [classId], references: [id])
}

model LessonPlan {
  id              String           @id @default(cuid())
  teacherId       String
  classId         String
  theme           String
  lessonDate      DateTime
  durationMinutes Int
  objectives      String
  content         String
  status          LessonPlanStatus @default(draft)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  teacher User  @relation(fields: [teacherId], references: [id])
  class   Class @relation(fields: [classId], references: [id])

  @@index([teacherId, lessonDate])
  @@index([classId, lessonDate])
  @@index([teacherId, status])
}

model ResearchActivity {
  id          String                 @id @default(cuid())
  organizerId String
  campusId    String
  type        ResearchActivityType
  title       String
  description String
  startAt     DateTime
  endAt       DateTime
  location    String
  status      ResearchActivityStatus @default(draft)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  organizer    User                  @relation("ResearchActivityOrganizer", fields: [organizerId], references: [id])
  campus       Campus                @relation(fields: [campusId], references: [id])
  participants ResearchParticipant[]

  @@index([campusId, startAt])
  @@index([organizerId, startAt])
  @@index([type, status])
}

model ResearchParticipant {
  id         String                      @id @default(cuid())
  activityId String
  teacherId  String
  status     ResearchParticipationStatus @default(registered)
  joinedAt   DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  activity ResearchActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  teacher  User             @relation(fields: [teacherId], references: [id])

  @@unique([activityId, teacherId])
  @@index([teacherId, status])
}

model GrowthRecord {
  id              String           @id @default(cuid())
  studentId       String
  teacherId       String?
  type            GrowthRecordType
  title           String
  content         String
  visibleToParent Boolean          @default(true)
  happenedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])
  teacher User?   @relation(fields: [teacherId], references: [id])
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  parentId  String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student   @relation(fields: [studentId], references: [id])
  messages Message[]

  @@unique([studentId, parentId, teacherId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  kind           MessageKind @default(text)
  content        String
  fileUrls       String[]    @default([])
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])
}

model Notice {
  id                  String     @id @default(cuid())
  classId             String
  teacherId           String
  kind                NoticeKind
  title               String
  content             String
  dueAt               DateTime?
  unboundStudentCount Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  class    Class           @relation(fields: [classId], references: [id])
  teacher  User            @relation("NoticeTeacher", fields: [teacherId], references: [id])
  receipts NoticeReceipt[]

  @@index([teacherId, createdAt])
  @@index([classId, createdAt])
}

model NoticeReceipt {
  id          String    @id @default(cuid())
  noticeId    String
  studentId   String
  parentId    String
  viewedAt    DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notice  Notice  @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  parent  User    @relation("NoticeReceiptParent", fields: [parentId], references: [id])

  @@unique([noticeId, studentId, parentId])
  @@index([parentId, createdAt])
  @@index([noticeId, confirmedAt])
}

model FileAsset {
  id            String   @id @default(cuid())
  url           String
  mimeType      String
  size          Int?
  ownerId       String?
  scene         String?
  storageDriver String   @default("local")
  storageKey    String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
