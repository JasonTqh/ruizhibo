# 本机容器验收使用两个不同 Host；真实部署改为两个 HTTPS 域名。
DEPLOY_SITE_ADDRESS=http://localhost
TEACHER_WEB_SITE_ADDRESS=http://teacher.localhost
APP_VERSION=local
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_DB=ruizhibo
POSTGRES_USER=ruizhibo
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# 密码包含特殊字符时，需要在 DATABASE_URL 中进行 URL 编码。
DATABASE_URL=postgresql://ruizhibo:replace-with-a-strong-database-password@db:5432/ruizhibo?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
TRAINING_MEDIA_SIGNING_SECRET=replace-with-an-independent-32-character-secret
CORS_ORIGINS=http://localhost:8080,http://teacher.localhost:8080
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
TRUST_PROXY_HOPS=1

# 仅限封闭测试环境。公网和生产环境必须设为 false。
ENABLE_DEV_LOGIN=false

WECHAT_TEACHER_APP_ID=
WECHAT_TEACHER_APP_SECRET=
WECHAT_PARENT_APP_ID=
WECHAT_PARENT_APP_SECRET=

# 默认使用 local。切换 COS/OSS/S3 时改为 s3 并填写以下配置。
FILE_STORAGE_DRIVER=local
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_TRAINING_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# 教师学院媒体与定时任务。素材访问地址最长不得超过 1800 秒。
TRAINING_MEDIA_URL_SECONDS=900
TRAINING_IMAGE_MAX_MB=10
TRAINING_VIDEO_MAX_MB=500
TRAINING_IDLE_SECONDS=300
TRAINING_JOB_INTERVAL_MS=900000

# 生产备份至少保留 30 天；由外部定时任务/对象存储生命周期执行。
BACKUP_RETENTION_DAYS=30

# 仅供 docker-compose.storage.yml 本地对象存储回归。
MINIO_ROOT_USER=ruizhibo
MINIO_ROOT_PASSWORD=ruizhibo-storage-test
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
